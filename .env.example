# ==============================================================================
# backapp Environment Configuration Example (.env)
# Copy this file to .env and customize values for your deployment:
#   cp .env.example .env
# ==============================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ==============================================================================
# Webhook Notifications (Discord, Slack, or Generic HTTP)
# ==============================================================================
# Leave blank to disable webhook notifications by default.
# Jobs can also specify their own 'discord_webhook' individually in their YAML.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# ==============================================================================
# Credentials & Secrets
# ==============================================================================
# Shared credentials used by hooks, database dump utilities, and RCON clients.
# These can be referenced in job YAML files via $RCON_PASS, $PGPASSWORD, etc.

# Minecraft RCON password (used by hooks.rcon or rcon-cli)
RCON_PASS=your_secret_rcon_password

# PostgreSQL password (used by pg_dump for postgres backup jobs)
PGPASSWORD=your_postgres_password

# MySQL / MariaDB password (used by mysqldump for mysql backup jobs)
MYSQL_PWD=your_mysql_root_password

# ==============================================================================
# Optional Overrides (Defaults work out-of-the-box in Docker)
# ==============================================================================
# BACKUP_JOBS_DIR=/etc/backup/jobs
# BACKAPP_SOCKET_PATH=/var/run/backapp/backapp.sock
